# Auth token required by the MCP gateway and forwarded by the session proxy
MCP_GATEWAY_AUTH_TOKEN=change-me

# No search API key is needed: `websearch` reads DuckDuckGo / Bing SERPs
# through headless Chromium and falls back to keyless indexes, and `searxng` is
# restricted to engines that require no key. This file is still the gateway's
# secrets store (--secrets), so it keeps the keys the other servers need.

# Optional: whisper model for the offline Klaket worker (`klaket` server).
# tiny|base|small|medium|large-v3 — default `small`. Compose reads it for
# interpolation only; it is not a secret and no MCP server receives it.
KLAKET_WHISPER_MODEL=small

# Telegram notification bot for the `telegram-notify` MCP server.
# Bot token from @BotFather; chat id of the ONE person/chat that may be
# notified (get it from https://api.telegram.org/bot<token>/getUpdates).
# The gateway injects both into the server; every send defaults to this chat
# (nothing in the stack ever passes a different one).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
