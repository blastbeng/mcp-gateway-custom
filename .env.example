# Auth token required by the MCP gateway and forwarded by the session proxy
MCP_GATEWAY_AUTH_TOKEN=change-me

# Tavily Search API key for the `tavily` MCP server (keyed search fallback).
# Free tier: 1,000 credits/month, no credit card required. Get one at
# https://app.tavily.com. The gateway reads this file as its secrets store
# (--secrets) and injects this value as TAVILY_API_KEY into the tavily server.
TAVILY_API_KEY=

# Telegram notification bot for the `telegram-notify` MCP server.
# Bot token from @BotFather; chat id of the ONE person/chat that may be
# notified (get it from https://api.telegram.org/bot<token>/getUpdates).
# The gateway injects both into the server; every send defaults to this chat
# (nothing in the stack ever passes a different one).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
